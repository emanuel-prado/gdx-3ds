.fvec projection[4]
.fvec modelview[4]
.fvec texscale
.constf constants(0.0, 1.0, 0.9999847412109375, 0.0)
.out outpos position
.out outuv texcoord0
.in inpos v0
.in inuv v3
.entry vmain
.proc vmain
    mov r0.xyz, inpos
    mov r0.w, constants.y
    dp4 r1.x, modelview[0], r0
    dp4 r1.y, modelview[1], r0
    dp4 r1.z, modelview[2], r0
    dp4 r1.w, modelview[3], r0
    dp4 outpos.x, projection[0], r1
    dp4 outpos.y, projection[1], r1
    dp4 outpos.z, projection[2], r1
    dp4 outpos.w, projection[3], r1
    mul r2.xy, constants.zz, inuv.xy
    flr r2.xy, r2.xy
    mul outuv.xy, texscale.xy, r2.xy
    end
.end
